{
  "name": "pgs-hundo-feed",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "FEED"
    }
  ],
  "observability": {
    "enabled": false
  },
  "vars": {
    "SOURCES": "[{\"name\":\"faustusfoundry\",\"url\":\"https://feed.faustusfoundry.com/pgrazor/hundos.json\",\"interval_s\":300},{\"name\":\"nycpokemap\",\"url\":\"https://nycpokemap.com/query2.php\",\"kind\":\"city\",\"interval_s\":600},{\"name\":\"sgpokemap\",\"url\":\"https://sgpokemap.com/query2.php\",\"kind\":\"city\",\"interval_s\":600},{\"name\":\"londonpogomap\",\"url\":\"https://londonpogomap.com/query2.php\",\"kind\":\"city\",\"interval_s\":600},{\"name\":\"sydneypogomap\",\"url\":\"https://sydneypogomap.com/query2.php\",\"kind\":\"city\",\"interval_s\":600},{\"name\":\"vanpokemap\",\"url\":\"https://vanpokemap.com/query2.php\",\"kind\":\"city\",\"interval_s\":600},{\"name\":\"iflowgo-pokemon\",\"url\":\"https://pokecoords.iflowgo.com/iflowgopokecoords/api/v1/pokemon-search\",\"kind\":\"iflow\",\"category\":\"pokemon\",\"interval_s\":600},{\"name\":\"iflowgo-raids\",\"url\":\"https://pokecoords.iflowgo.com/iflowgopokecoords/api/v1/nearby\",\"kind\":\"iflow\",\"category\":\"raids\",\"interval_s\":600}]"
  }
}
